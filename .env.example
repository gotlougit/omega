# OpenAI API key (used only by Chat Completions)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional API family. Defaults to chat-completions; set to responses to use
# the Codex Responses endpoint with ChatGPT OAuth credentials.
# OPENAI_API_TYPE=responses

# Optional: model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: full Chat Completions endpoint (for proxies / local models)
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Required in responses mode: pass the access_token and account_id values from
# Codex credentials to omega-loop. OPENAI_API_KEY is not used in this mode.
# OPENAI_RESPONSES_ACCESS_TOKEN=your-codex-oauth-access-token
# OPENAI_RESPONSES_ACCOUNT_ID=your-chatgpt-account-id
# Optional: refresh an expiring/rejected access token automatically. A rotated
# refresh token is kept in memory and persisted with the new access token.
# Do not share one rotating refresh token with another Codex process.
# OPENAI_RESPONSES_REFRESH_TOKEN=your-codex-oauth-refresh-token
# Path to this writable file for atomic token persistence. The NixOS module
# sets this automatically from services.omega.envFile.
# OPENAI_RESPONSES_ENV_FILE=/var/lib/clanker/omega/.env
# Advanced OAuth overrides (normally leave unset):
# OPENAI_RESPONSES_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# OPENAI_RESPONSES_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# Set OPENAI_MODEL above to a model available to the Codex account.
# Optional Responses reasoning effort: none, minimal, low, medium, high, xhigh,
# or max. This overrides the effort inferred from omega's think setting.
# OPENAI_REASONING_EFFORT=medium
# Optional full endpoint; this is the default for responses mode.
# OPENAI_RESPONSES_BASE_URL=https://chatgpt.com/backend-api/codex/responses

# Optional: output token cap. Sent as max_tokens for Chat Completions and
# max_output_tokens for Responses. Unset means the upstream default.
# OPENAI_MAX_TOKENS=16384

# Optional: directory for the project store (registered repos + worktrees).
# When running via the NixOS module this is set by services.omega.projectsDir
# (default: /persist/clanker/projects), so it normally doesn't need to be set
# here.  When running omega-loop directly it defaults to ./projects relative
# to the daemon's working directory.
# OMEGA_PROJECTS_DIR=/persist/clanker/projects

# Optional: path to the rebase-cron defaults file (interval, cron-jobbable
# projects, upstream-rebaser system prompt). When running via the NixOS
# module this is set by services.omega.rebaseJob, which writes
# /etc/omega/rebase-job.defaults.json.  Without it, omega-loop runs the
# cron with its built-in defaults (6h interval, no projects — use the web
# UI's /rebase page to add projects imperatively).
# OMEGA_REBASE_JOB_CONFIG=/etc/omega/rebase-job.defaults.json

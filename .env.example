# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: custom base URL (for proxies / local models)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: max tokens (default: 16384)
# OPENAI_MAX_TOKENS=16384

# Optional: directory for the project store (registered repos + worktrees).
# When running via the NixOS module this is set by services.omega.projectsDir
# (default: /persist/clanker/projects), so it normally doesn't need to be set
# here.  When running omega-loop directly it defaults to ./projects relative
# to the daemon's working directory.
# OMEGA_PROJECTS_DIR=/persist/clanker/projects
